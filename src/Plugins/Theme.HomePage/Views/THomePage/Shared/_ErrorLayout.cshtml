<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="/Plugins/Theme.HomePage/Content/css/tailwind.css?v=@DateTime.Now.Ticks" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans antialiased text-gray-900">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
